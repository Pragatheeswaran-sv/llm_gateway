APP_NAME=LLM Gateway
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:5432/llmservice
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CLIENT_SECRET_HASH_PEPPER=replace-with-a-stable-private-pepper
API_KEY_ENCRYPTION_KEY=set-api-encryption-key
