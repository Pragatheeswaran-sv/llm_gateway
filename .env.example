APP_NAME=LLM Gateway

# Used when running Poetry/Alembic directly on Windows/host.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/llm_service

# Docker Compose overrides DATABASE_URL with this value inside the container.
DOCKER_DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:5432/llm_service

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CLIENT_SECRET_HASH_PEPPER=replace-with-a-stable-private-pepper

# Only needed when seeding one-account fallback rows.
GROQ_API_KEY=

# Optional live integration-test settings.
RUN_LIVE_LLM_TESTS=0
TEST_API_URL=http://localhost:8000/api/v1/generate
TEST_ACCESS_TOKEN=
